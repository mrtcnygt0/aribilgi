@{
}
<!-- Model tipi belirtilmesi gerek yoksa listelemeyebilir -->
@model List<Urun>

    <h1>Ürünler</h1>
    <hr />

@foreach (var item in Model)
{
    <div class="card">
        <h2>@item.UrunAd</h2>
        <p>@item.Marka</p>
        <p>@item.Model</p>
        <p>@item.Fiyat</p>
    </div>
}