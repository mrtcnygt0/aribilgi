@model IEnumerable<EntityCodeFirst2.Models.Oyuncu>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OyuncuName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KayitTarihi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NickName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.XP)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.OyuncuName)
            </td>
            <td>
                @Html.DisplayFor(model => item.KayitTarihi)
            </td>
            <td>
                @Html.DisplayFor(model => item.NickName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.XP)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OyuncuID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OyuncuID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OyuncuID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
