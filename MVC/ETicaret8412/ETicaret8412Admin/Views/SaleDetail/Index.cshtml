@model IEnumerable<ETicaret8412Admin.Models.SaleDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SaleId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sale)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.SaleId)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.Product)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sale)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SaleDetailId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SaleDetailId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SaleDetailId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
